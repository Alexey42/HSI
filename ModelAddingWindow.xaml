<Window x:Class="HSI.ModelAddingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HSI"
        mc:Ignorable="d"
        Title="Добавить эталон"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Label Content="R" Padding="0" />
                <TextBox x:Name="usersRed"
                         Text="0"
                         MinHeight="28"
                         VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="G" Padding="0" />
                <TextBox x:Name="usersGreen"
                         Text="0"
                         MinHeight="28"
                         VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <Label Content="B" Padding="0" />
                <TextBox x:Name="usersBlue"
                         Text="0"
                         MinHeight="28"
                         VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2">
            <Label Content="Имя эталона" Padding="0" />
            <TextBox x:Name="modelName"
                     Text="model"
                     MinHeight="28"
                     VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Ок"
                    IsDefault="True"
                    Click="Accept_Click"
                    Width="90"
                    Margin="0,0,8,0" />
            <Button Content="Отмена"
                    IsCancel="True"
                    Width="90" />
        </StackPanel>
    </Grid>
</Window>
