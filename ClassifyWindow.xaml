<Window x:Class="HSI.ClassifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HSI"
        mc:Ignorable="d"
        Title="Классификация"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <Label Content="Метод"
               VerticalAlignment="Center"
               Padding="0"
               ToolTip="Способ сравнения пикселя с добавленными эталонами: по спектральному углу, нормированному евклидову расстоянию или барицентрическим координатам." />
        <ComboBox x:Name="method_list"
                  Grid.Column="1"
                  SelectedIndex="2"
                  SelectionChanged="ComboBox_SelectionChanged"
                  ToolTip="Спектральный угол устойчивее к общей яркости; евклидово расстояние чувствительно к яркости каналов; барицентрические координаты сравнивают пиксель через матрицу эталона."
                  MinHeight="28">
            <ComboBoxItem Name="ClassifyAngle">Спектральный угол</ComboBoxItem>
            <ComboBoxItem Name="ClassifyEuclid">Евклидово расстояние</ComboBoxItem>
            <ComboBoxItem Name="ClassifyBarycentric">Барицентрические координаты</ComboBoxItem>
        </ComboBox>

        <Label Grid.Row="2"
               Content="Порог"
               VerticalAlignment="Center"
               Padding="0"
               ToolTip="Максимальное отклонение от эталона. Больше порог - больше пикселей попадёт в классы, но выше риск ошибок." />
        <TextBox x:Name="threshold_textbox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Text="8.0"
                 MinHeight="28"
                 ToolTip="Максимальное отклонение от эталона. Для спектрального угла это градусы; для других методов это условная мера близости из выбранного алгоритма."
                 VerticalContentAlignment="Center" />

        <StackPanel Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Ок"
                    IsDefault="True"
                    Click="Accept_Click"
                    Width="90"
                    Margin="0,0,8,0" />
            <Button Content="Отмена"
                    IsCancel="True"
                    Width="90" />
        </StackPanel>
    </Grid>
</Window>
