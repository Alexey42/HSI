<Window x:Class="HSI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cm="clr-namespace:System.ComponentModel;assembly=System"
        xmlns:local="clr-namespace:HSI"
        mc:Ignorable="d"
        Title="HSI - обработка спутниковых снимков"
        Height="680"
        Width="1080"
        MinHeight="560"
        MinWidth="900"
        Background="#F4F6F8">
    <Window.Resources>
        <cm:BackgroundWorker x:Key="backgroundWorker"
                             DoWork="BackgroundWorker_DoWork"
                             RunWorkerCompleted="BackgroundWorker_RunWorkerCompleted"
                             WorkerReportsProgress="True"
                             ProgressChanged="BackgroundWorker_ProgressChanged" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2933" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5E6C7A" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть">
                    <MenuItem Header=".tif" Click="OpenImage_Click" />
                    <MenuItem Header=".png" Click="OpenImage_Click" />
                    <MenuItem Header=".jpeg" Click="OpenImage_Click" />
                    <MenuItem Header=".jpeg2000" Click="OpenImage_Click" />
                    <MenuItem Header="Другой формат" Click="OpenImage_Click" />
                </MenuItem>
                <MenuItem Header="Сохранить как..." Click="SaveImage_Click" />
                <Separator />
                <MenuItem Header="Очистить" Click="ClearCanvas" />
            </MenuItem>
            <MenuItem Header="Функции">
                <MenuItem Header="Гистограмма файла" Click="hist_fromFile_click" />
                <MenuItem Header="EMD" Click="EMD_btn_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="#D8DEE6"
                BorderThickness="0,1,0,0"
                Background="#FFFFFF"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="statusText"
                           Text="Готово"
                           VerticalAlignment="Center"
                           Foreground="#44515F"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="progressBar"
                             Grid.Column="1"
                             Height="10"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#D8DEE6"
                    BorderThickness="1"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <WrapPanel>
                    <Button x:Name="addImage_btn"
                            Content="Добавить изображение"
                            Click="Button_Click"
                            ToolTip="Собрать RGB-снимок из трех выбранных каналов" />
                    <Button x:Name="saveImage_btn"
                            Content="Сохранить как..."
                            Click="SaveImage_Click"
                            ToolTip="Сохранить текущее изображение в выбранный файл" />
                    <Button x:Name="crop_btn"
                            Content="Обрезать"
                            Click="CropImage_Click"
                            ToolTip="Выделить область и сразу работать с обрезанным изображением" />
                    <Button x:Name="calcRaster_btn"
                            Content="Калькулятор растров"
                            Click="calcRaster_btn_Click"
                            ToolTip="Вычислить индекс по формуле из выбранных каналов" />
                    <Button x:Name="setModel_btn"
                            Content="Добавить эталон"
                            Click="setModel_btn_Click"
                            ToolTip="Выберите область на изображении, затем задайте имя и цвет класса" />
                    <Button x:Name="classify_btn"
                            Content="Классификация"
                            Click="classify_btn_Click"
                            ToolTip="Раскрасить пиксели по добавленным эталонам" />
                    <Button x:Name="segment_btn"
                            Content="Сегментация"
                            Click="segment_btn_Click"
                            ToolTip="Сегментация текущего изображения по спектральному углу" />
                    <Button x:Name="EMD_btn"
                            Content="EMD"
                            Click="EMD_btn_Click"
                            Visibility="Collapsed"
                            ToolTip="Выполнить EMD для AVIRIS-снимка" />
                </WrapPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="520" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#FFFFFF"
                        BorderBrush="#D8DEE6"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Grid x:Name="canvas_main"
                          Background="#E5EAF0"
                          ClipToBounds="True">
                        <local:ZoomBorder x:Name="zoom_border"
                                          ClipToBounds="True"
                                          Background="#E5EAF0">
                            <Image Name="scr_img"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Stretch="None"
                                   Width="{Binding Source.PixelWidth, RelativeSource={RelativeSource Self}}"
                                   Height="{Binding Source.PixelHeight, RelativeSource={RelativeSource Self}}"
                                   MouseLeftButtonDown="scr_img_MouseLeftButtonDown"
                                   MouseLeftButtonUp="scr_img_MouseLeftButtonUp"
                                   MouseMove="scr_img_MouseMove">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="scr_img_scale" CenterX="0.5" CenterY="0.5" />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                        </local:ZoomBorder>

                        <Rectangle x:Name="rect_for_wrap"
                                   Fill="#4D2F80ED"
                                   StrokeThickness="2"
                                   StrokeDashArray="4 2"
                                   Stroke="#FFFFFF"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top">
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterX="0" CenterY="0" />
                                    <TranslateTransform />
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <TextBlock x:Name="emptyStateText"
                                   Text="Нет изображения"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#6B7785"
                                   FontSize="18" />
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="#FFFFFF"
                        BorderBrush="#D8DEE6"
                        BorderThickness="1"
                        Padding="12"
                        Margin="12,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Эталоны" Style="{StaticResource PanelTitle}" />
                        <TextBlock x:Name="modelsHintText"
                                   Grid.Row="1"
                                   Text="После загрузки изображения выделите область и задайте класс."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,0,0,12" />
                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="modelsPanel" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="legendPanel"
                    Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#D8DEE6"
                    BorderThickness="1"
                    Padding="12,10"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="legendTitle"
                               FontWeight="SemiBold"
                               Foreground="#1F2933"
                               VerticalAlignment="Center" />
                    <StackPanel x:Name="legendContent"
                                Grid.Column="1"
                                Orientation="Vertical" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
